<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ecommerce Shopping Cart</title>
</head>

<body>

    <h1>Shopping Cart</h1>

    <% if (products.length === 0) { %>

        <h3>Your cart is empty.</h3>
        <a href="/product">Continue Shopping</a>

    <% } else { %>

        <% for (let item of products) { %>

            <div>
                <h2>
                    <%= item.product.title %>
                </h2>

                <p>
                    Price: &#8377;<%= item.product.price %>
                </p>

                <div>
                    Quantity:

                    <form action="/cart/decrease/<%= item.product._id %>" method="POST" style="display:inline;">
                        <button type="submit">-</button>
                    </form>

                    <%= item.quantity %>

                    <form action="/cart/increase/<%= item.product._id %>" method="POST" style="display:inline;">
                        <button type="submit">+</button>
                    </form>
                </div>

                <p>
                    Subtotal:
                    &#8377;<%= item.product.price * item.quantity %>
                </p>

                <form action="/cart/remove/<%= item.product._id %>" method="POST">
                    <button type="submit">Remove</button>
                </form>

            </div>

            <hr>

        <% } %>

        <h2>
            Total: &#8377;<%= total %>
        </h2>

        <a href="/checkout">Checkout</a>

        <br><br>

        <a href="/profile">Profile</a>

        <br><br>

        <a href="/logout">Logout</a>

    <% } %>

</body>

</html>